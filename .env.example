# Copy to .env and fill in. Loaded from an absolute path by src/env.ts, so it
# works whichever directory you run a command from.

# Groq, for answers and follow-up rewriting.
# Free tier: 8000 tokens/minute, which is the binding constraint on this app.
# https://console.groq.com/keys
GROQ_API_KEY=

# HuggingFace, for embeddings (BAAI/bge-small-en-v1.5 over their inference API).
# Set EMBEDDING_PROVIDER = "local" in src/config.ts to run the model locally
# instead and drop this.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: point the three SQLite files and the ingested originals somewhere
# else. Defaults to <repo>/storage. The API contract tests use this to run
# against a temporary directory instead of your real notebooks.
# NOTEBOOK_STORAGE_DIR=

# Recommended on any deployment reachable from the internet: without it anyone
# who finds the URL can register an account and spend your Groq quota. With it,
# only people you give the code to can sign up.
# NOTEBOOK_SIGNUP_CODE=

# Set to 1 when serving over HTTPS. Adds `Secure` to the session cookie so it
# can never travel over a plaintext connection. Off by default so signing in on
# http://localhost works.
# NOTEBOOK_SECURE_COOKIE=

# Optional: override the port. Most hosts inject PORT instead.
# NOTEBOOK_API_PORT=
